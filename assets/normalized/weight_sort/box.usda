#usda 1.0
(
    customLayerData = {
        string coribenchAssetSchemaVersion = "1.0"
        string coribenchSourceAsset = "flatbox_a02_graspable.usda"
    }
    defaultPrim = "Box"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Box" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    custom string coribench:modelSchemaVersion = "1.0"
    custom string coribench:originConvention = "support_plane_primary_mate_axis"

    def Xform "Source" (
        delete apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @../../flatbox_a02_graspable.usda@
    )
    {
        double3 xformOp:translate:coribenchNormalization = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate:coribenchNormalization"]
    }

    def Scope "Frames"
    {
        def Xform "Support"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Grasp"
        {
            double3 xformOp:translate = (0, 0, 0.0150406198)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Mate"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

