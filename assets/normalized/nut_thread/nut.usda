#usda 1.0
(
    customLayerData = {
        string coribenchAssetSchemaVersion = "1.0"
        string coribenchSourceAsset = "nut_m16.usd"
    }
    defaultPrim = "Nut"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Nut" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    custom string coribench:modelSchemaVersion = "1.0"
    custom string coribench:originConvention = "support_plane_primary_mate_axis"

    def Xform "Source" (
        prepend references = @../../nut_m16.usd@
    )
    {
        double3 xformOp:translate:coribenchNormalization = (0, 0, -0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:translate:coribenchNormalization"]

        over "factory_nut_loose" (
            delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
        }
    }

    def Scope "Frames"
    {
        def Xform "Support"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Grasp"
        {
            double3 xformOp:translate = (0, 0, 0.0065)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "Mate"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
