#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "World" (
    prepend references = @./EastRural_Table.usd@
)
{
    over "Looks"
    {
        over "TableTop"
        {
            over "Shader"
            {
                asset inputs:diffuse_texture = @./Textures/PolyHaven_AshVeneer_Diffuse_4K.jpg@
                asset inputs:normalmap_texture = @./Textures/PolyHaven_AshVeneer_NormalGL_4K.jpg@
                asset inputs:reflectionroughness_texture = @./Textures/PolyHaven_AshVeneer_Roughness_4K.jpg@
            }
        }
    }
}
